# ── Core ──────────────────────────────────────────────
DATABASE_URL="postgresql://hirely:hirely@localhost:5432/hirely"
APP_URL="http://localhost:3000"
# 32-byte base64 key used for AES-256-GCM encryption of secrets, TOTP seeds and stored files.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=""
# Run the background job worker inside the Next.js process (convenient for demos).
# In production set to "false" and run `npm run worker` as a separate process.
INLINE_WORKER="true"
# Multiplier applied to automation "wait" steps. 1 = real time. 0.001 turns 24h into ~86s for demos.
AUTOMATION_TIME_SCALE="1"
# Secret for /api/cron/tick when triggered by an external scheduler
CRON_SECRET=""

# ── AI (LLM) — leave empty to use the deterministic mock provider ──
LLM_PROVIDER=""              # "anthropic" | "openai" | "mock"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5-5"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"
TRANSCRIPTION_PROVIDER=""    # "openai" | "mock"

# ── Voice — Twilio programmable voice (mock if empty) ──
VOICE_PROVIDER=""            # "twilio" | "mock"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# ── Email / SMS ──
EMAIL_PROVIDER=""            # "resend" | "postmark" | "mock"
RESEND_API_KEY=""
POSTMARK_TOKEN=""
EMAIL_FROM="Hirely <recruiting@hirely.app>"
SMS_PROVIDER=""              # "twilio" | "mock"

# ── Calendar OAuth ──
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# ── Billing ──
BILLING_PROVIDER=""          # "stripe" | "mock"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ── Storage ──
STORAGE_PROVIDER="local"     # "local" (encrypted on disk) | "s3"
STORAGE_DIR="./storage"
